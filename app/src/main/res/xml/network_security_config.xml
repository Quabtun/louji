<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS-only by default. localhost / 10.0.2.2 stay open so the MockWebServer-based
     instrumentation tests can drive GitHubUpdater; release builds never talk to them
     (the updater's host whitelist rejects any non-GitHub host). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
