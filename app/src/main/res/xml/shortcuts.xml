<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_record"
        android:enabled="true"
        android:icon="@drawable/ic_stairs"
        android:shortcutShortLabel="@string/shortcut_quick_record"
        android:shortcutLongLabel="@string/shortcut_quick_record_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="${applicationId}"
            android:targetClass="com.quabtun.louji.MainActivity">
            <extra
                android:name="louji.shortcut"
                android:value="record" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="paste_record"
        android:enabled="true"
        android:icon="@drawable/ic_export"
        android:shortcutShortLabel="@string/shortcut_paste_record"
        android:shortcutLongLabel="@string/shortcut_paste_record_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="${applicationId}"
            android:targetClass="com.quabtun.louji.MainActivity">
            <extra
                android:name="louji.shortcut"
                android:value="paste" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="search_radar"
        android:enabled="true"
        android:icon="@drawable/ic_building"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="${applicationId}"
            android:targetClass="com.quabtun.louji.MainActivity">
            <extra
                android:name="louji.shortcut"
                android:value="search" />
        </intent>
    </shortcut>
</shortcuts>
